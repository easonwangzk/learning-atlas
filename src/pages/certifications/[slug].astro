---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CertificationDetailView from "@/components/CertificationDetailView.astro";
import { certifications, getCertification } from "@/data/certifications";
export function getStaticPaths() { return certifications.map((cert) => ({ params: { slug: cert.slug } })); }
const locale = "zh"; const cert = getCertification(Astro.params.slug ?? ""); if (!cert) return Astro.redirect("/404.html");
---
<BaseLayout title={cert.title.zh} description={cert.intro.zh} current="Certifications" locale={locale} pageKind="certifications" contextLabel="Certifications"><CertificationDetailView locale={locale} cert={cert} /></BaseLayout>
