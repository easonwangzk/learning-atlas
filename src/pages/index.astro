---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BilingualStage from "@/components/BilingualStage.astro";
import { tracks } from "@/data/tracks";
import { getProjects } from "@/data/projects";
import { getResources } from "@/data/resources";
import { getCollection } from "astro:content";
import { lessonLocale, lessonProgressId } from "@/lib/lessons";

const locale = "zh";
const lessons = (await getCollection("lessons")).filter((lesson) => lessonLocale(lesson) === locale);
const lessonIds = lessons.map(lessonProgressId);
const projects = getProjects(locale);
const resources = getResources(locale);
---

<BaseLayout title="Learning Atlas" description="计算、存储、网络、数据库、AI 与机器学习的中文静态学习地图。" current="Home" locale={locale} scene>
  <BilingualStage locale={locale} projects={projects} tracks={tracks} lessonIds={lessonIds} resourceCount={resources.length} />
</BaseLayout>
