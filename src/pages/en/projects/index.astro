---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectIndexView from "@/components/ProjectIndexView.astro";
import { getProjects } from "@/data/projects";
const locale = "en";
const projects = getProjects(locale);
---
<BaseLayout title="Projects" description="README-based learning cases from public GitHub projects." current="Projects" locale={locale} pageKind="projects" contextLabel="Projects"><ProjectIndexView locale={locale} projects={projects} /></BaseLayout>
