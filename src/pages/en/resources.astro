---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResourceView from "@/components/ResourceView.astro";
import { getResources } from "@/data/resources";
const locale = "en";
const resources = getResources(locale);
---
<BaseLayout title="Resources" description="A stable index for Microsoft Learn, Azure docs, and ML/AI references." current="Resources" locale={locale} pageKind="resources" contextLabel="Resources"><ResourceView locale={locale} resources={resources} /></BaseLayout>
