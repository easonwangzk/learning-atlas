---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchView from "@/components/SearchView.astro";
import { getSearchIndex } from "@/data/searchIndex";
const locale = "en";
const items = await getSearchIndex(locale);
---
<BaseLayout title="Search" description="Search Learning Atlas lessons, projects, and resources." current="Search" locale={locale} pageKind="search" contextLabel="Search"><SearchView locale={locale} items={items} /></BaseLayout>
