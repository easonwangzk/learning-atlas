---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LessonView from "@/components/LessonView.astro";
import { getTrack, trackText } from "@/data/tracks";
import { getCollection, render } from "astro:content";
import { lessonLocale, lessonSlug, lessonProgressId, lessonRoute } from "@/lib/lessons";
export async function getStaticPaths() {
  const lessons = (await getCollection("lessons")).filter((lesson) => lessonLocale(lesson) === "en");
  return lessons.map((lesson) => ({ params: { track: lesson.data.track, slug: lessonSlug(lesson) }, props: { lesson } }));
}
const { lesson } = Astro.props;
const { Content } = await render(lesson);
const locale = "en";
const track = getTrack(lesson.data.track);
const trackLabel = track ? trackText(track, locale).title : lesson.data.track;
const lessonId = lessonProgressId(lesson);
const peers = (await getCollection("lessons")).filter((item) => item.data.track === lesson.data.track && lessonLocale(item) === locale).sort((a, b) => a.data.order - b.data.order);
const idx = peers.findIndex((item) => lessonSlug(item) === lessonSlug(lesson));
const previous = idx > 0 ? { title: peers[idx - 1].data.title, href: lessonRoute(peers[idx - 1], locale) } : undefined;
const next = idx < peers.length - 1 ? { title: peers[idx + 1].data.title, href: lessonRoute(peers[idx + 1], locale) } : undefined;
---
<BaseLayout title={lesson.data.title} description={lesson.data.summary} current="Learn" locale={locale} pageKind="lesson" contextLabel={trackLabel} crumbs={[{ label: "Learn", href: "/en/learn/" }, { label: trackLabel, href: `/en/learn/${lesson.data.track}/` }, { label: lesson.data.title }]}><LessonView locale={locale} lesson={lesson} lessonId={lessonId} trackLabel={trackLabel} previous={previous} next={next}><Content /></LessonView></BaseLayout>
