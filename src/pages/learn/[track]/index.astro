---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TrackView from "@/components/TrackView.astro";
import { getTrack, tracks, trackText } from "@/data/tracks";
import { getCollection } from "astro:content";
import { lessonLocale } from "@/lib/lessons";
export async function getStaticPaths() { return tracks.map((track) => ({ params: { track: track.slug } })); }
const { track: trackSlug } = Astro.params;
const track = getTrack(trackSlug || "");
if (!track) throw new Error(`Unknown learning track: ${trackSlug}`);
const locale = "zh";
const text = trackText(track, locale);
const lessons = (await getCollection("lessons")).filter((lesson) => lesson.data.track === track.slug && lessonLocale(lesson) === locale).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title={text.title} description={text.summary} current="Knowledge" locale={locale} pageKind="track" contextLabel={text.title} crumbs={[{ label: "知识", href: "/learn/" }, { label: text.title }]}><TrackView locale={locale} track={track} text={text} lessons={lessons} allTracks={tracks} /></BaseLayout>
