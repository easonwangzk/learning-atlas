---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LearnView from "@/components/LearnView.astro";
import { getCollection } from "astro:content";
import { lessonLocale } from "@/lib/lessons";
const locale = "zh";
const lessons = (await getCollection("lessons")).filter((lesson) => lessonLocale(lesson) === locale);
---
<BaseLayout title="Learn" description="课程目录：Compute、Storage、Network、Database、AI、ML。" current="Learn" locale={locale} pageKind="learn" contextLabel="Learn"><LearnView locale={locale} lessons={lessons} /></BaseLayout>
