---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResourceView from "@/components/ResourceView.astro";
import { getResources } from "@/data/resources";
const locale = "zh";
const resources = getResources(locale);
// ResourceView renders the public archive wording “整理于 2026-10-10”.
---
<BaseLayout title="资源索引" description="Microsoft Learn、Azure 文档与 ML/AI 稳定资源索引。" current="Resources" locale={locale} pageKind="resources" contextLabel="Resources"><ResourceView locale={locale} resources={resources} /></BaseLayout>
