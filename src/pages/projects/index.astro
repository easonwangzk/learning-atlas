---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectIndexView from "@/components/ProjectIndexView.astro";
import { getProjects } from "@/data/projects";
const locale = "zh";
const projects = getProjects(locale);
---
<BaseLayout title="项目案例" description="公开 GitHub 项目的 README-based 学习案例。" current="Projects" locale={locale} pageKind="projects" contextLabel="Projects"><ProjectIndexView locale={locale} projects={projects} /></BaseLayout>
