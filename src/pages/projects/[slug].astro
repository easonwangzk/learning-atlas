---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectView from "@/components/ProjectView.astro";
import { getProjects, getProject } from "@/data/projects";
const locale = "zh";
const projects = getProjects(locale);
export function getStaticPaths() { return getProjects("zh").map((project) => ({ params: { slug: project.slug } })); }
const project = getProject(Astro.params.slug || "", locale);
if (!project) throw new Error(`Unknown project: ${Astro.params.slug}`);
const previous = projects[(project.index + projects.length - 1) % projects.length];
const next = projects[(project.index + 1) % projects.length];
---
<BaseLayout title={project.title} description={project.summary} current="Projects" locale={locale} canonicalPath={`/projects/${project.slug}/`} pageKind="project" contextLabel={project.title} crumbs={[{ label: "项目", href: "/projects/" }, { label: project.title }]}><ProjectView locale={locale} project={project} previous={previous} next={next} /></BaseLayout>
