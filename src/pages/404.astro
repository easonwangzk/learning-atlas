---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/paths";
const locale = "zh";
---
<BaseLayout title="404" description="页面未找到。" locale={locale}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>这条路径还没有课程。</h1>
      <p class="lead">请返回知识地图或使用全站搜索。</p>
      <a class="button primary" href={withBase("/learn/")}>返回知识地图</a>
      <a class="button" href={withBase("/search/")}>搜索</a>
    </div>
  </section>
</BaseLayout>
