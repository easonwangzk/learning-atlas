---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchView from "@/components/SearchView.astro";
import { getSearchIndex } from "@/data/searchIndex";
const locale = "zh";
const items = await getSearchIndex(locale);
---
<BaseLayout title="搜索" description="搜索 Learning Atlas 的课程、项目和资源。" current="Search" locale={locale} pageKind="search" contextLabel="Search"><SearchView locale={locale} items={items} /></BaseLayout>
