---
import BaseLayout from "@/layouts/BaseLayout.astro";
import KnowledgeMapView from "@/components/KnowledgeMapView.astro";
import { getCollection } from "astro:content";
import { lessonLocale } from "@/lib/lessons";
const locale = "zh";
const lessons = (await getCollection("lessons")).filter((lesson) => lessonLocale(lesson) === locale);
---
<BaseLayout title="Knowledge Map" description="六条知识线交互地图。" current="KnowledgeMap" locale={locale} pageKind="knowledge-map" contextLabel="KnowledgeMap"><KnowledgeMapView locale={locale} lessons={lessons} /></BaseLayout>
