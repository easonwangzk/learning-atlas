---
import { withBase } from "@/lib/paths";
import { localizePath, type Locale } from "@/i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const isEn = locale === "en";
---
<section class="atlas-page atlas-notfound"><div class="atlas-container notfound-wrap" data-reveal><p class="notfound-code">404</p><h1 data-notfound-title>{isEn ? "This path is not in the atlas." : "这条路径不存在。"}</h1><p class="lead" data-notfound-description>{isEn ? "Return to Learn or use site search." : "请返回系统学习或使用全站搜索。"}</p><p><a class="text-button" data-notfound-link="learn" href={withBase(localizePath("/learn/", locale))}>{isEn ? "Learn" : "系统学习"}</a> <a class="text-link" data-notfound-link="search" href={withBase(localizePath("/search/", locale))}>{isEn ? "Search" : "搜索"}</a></p>{!isEn && <noscript><p lang="en">For the English not-found page, <a href={withBase("/en/404/")}>continue in English</a>.</p></noscript>}</div></section>
