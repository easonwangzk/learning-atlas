---
import { tracks, trackText } from "@/data/tracks";
import { labs, labText } from "@/data/labs";
import { certifications } from "@/data/certifications";
import { getProjects } from "@/data/projects";
import { withBase } from "@/lib/paths";
import { lessonProgressId, lessonRoute } from "@/lib/lessons";
import { localizePath, type Locale } from "@/i18n";
import type { Lesson } from "@/lib/viewTypes";
interface Props { locale: Locale; lessons: readonly Lesson[] }
const { locale, lessons } = Astro.props;
const isEn = locale === "en";
const projects = getProjects(locale);
const positions = { compute: [16, 27], network: [42, 20], storage: [16, 65], database: [45, 66], ai: [77, 29], ml: [77, 66] } as const;
const edges = [
  ["compute", "network", "M22 27 C30 22 34 20 42 20"],
  ["compute", "storage", "M16 34 L16 58"],
  ["network", "database", "M43 27 L45 59"],
  ["storage", "database", "M23 65 L38 66"],
  ["database", "ai", "M51 63 C63 55 72 45 77 36"],
  ["database", "ml", "M52 66 L70 66"],
  ["ai", "ml", "M77 36 L77 59"]
] as const;
const copy = {
  title: isEn ? "Knowledge Map" : "知识地图",
  lead: isEn ? "See relationships first; follow courses in Learn. Select a node to see its lessons, lab, related cases, and certification context." : "先看知识之间的关系，再到系统学习按路径读课程。选择节点查看关联课程、实验、项目和认证背景。",
  legend: isEn ? "Illustrative learning relationships, not mandatory prerequisites or a production topology." : "连线表达学习关系，不是强制先修顺序，也不是生产部署拓扑。"
};
---
<section class="atlas-page map-page">
  <div class="atlas-container">
    <header class="atlas-intro" data-reveal><p class="eyebrow">{isEn ? "Explore relationships" : "理解知识关系"}</p><h1>{copy.title}</h1><p class="lead">{copy.lead}</p></header>
    <div class="map-shell" data-knowledge-map>
      <div class="map-diagram" role="group" aria-label={copy.title}>
        <svg class="architecture-map" viewBox="0 0 100 90" aria-hidden="true">
          <g class="map-lines">{edges.map(([from, to, d]) => <path data-map-link={`${from} ${to}`} d={d} />)}</g>
        </svg>
        {tracks.map((track, index) => {
          const [x, y] = positions[track.slug];
          const text = trackText(track, locale);
          return <a class="map-node-link" href={`#${track.slug}`} data-map-node={track.slug} aria-controls={track.slug} style={`left:${x}%;top:${y / 90 * 100}%`}>
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><strong>{text.title}</strong>
          </a>;
        })}
        <p class="map-controls">{isEn ? "Identity · Governance · Security · Monitoring · Continuity · Cost" : "身份 · 治理 · 安全 · 监控 · 连续性 · 成本"}</p>
      </div>
      <div class="map-detail-list">
        {tracks.map((track) => {
          const text = trackText(track, locale);
          const peers = lessons.filter((lesson) => lesson.data.track === track.slug).sort((a, b) => a.data.order - b.data.order);
          const ids = peers.map(lessonProgressId);
          const lab = labs.find((item) => item.track === track.slug);
          const relatedProjects = projects.filter((item) => item.related.some((path) => path.includes(`/learn/${track.slug}/`)));
          const certs = certifications.filter((cert) => cert.domains.some((domain) => domain.mappedLessons.some((id) => ids.includes(id))));
          return <section id={track.slug} class="map-detail" data-map-detail={track.slug}>
            <p class="eyebrow">{text.kicker}</p><h2>{text.title}</h2><p>{text.summary}</p>
            <p><strong data-progress-count={ids.join(",")}>0/{ids.length}</strong> {isEn ? "lessons complete" : "篇课程已完成"}</p>
            <h3>{isEn ? "Courses" : "课程"}</h3>
            <ul>{peers.map((lesson) => <li><a href={withBase(lessonRoute(lesson, locale))}>{lesson.data.title}</a></li>)}</ul>
            {lab && <p><a href={withBase(localizePath(`/labs/${lab.slug}/`, locale))}>{labText(lab, locale).title}</a></p>}
            {relatedProjects.length > 0 && <details><summary>{isEn ? "Related public cases" : "关联公开项目"}</summary><ul>{relatedProjects.map((project) => <li><a href={withBase(localizePath(`/projects/${project.slug}/`, locale))}>{project.title}</a></li>)}</ul></details>}
            {certs.length > 0 && <p class="map-cert-links">{certs.map((cert) => <a href={withBase(localizePath(`/certifications/${cert.slug}/`, locale))}>{cert.code}</a>)}</p>}
            <a class="text-link" href={withBase(localizePath(`/learn/${track.slug}/`, locale))}>{isEn ? "Open learning path" : "进入学习路径"} →</a>
          </section>;
        })}
      </div>
    </div>
    <p class="muted">{copy.legend}</p>
    <p class="muted">{isEn ? "Machine learning is a field of AI; this site separates AI application engineering from model/data development for learning convenience." : "机器学习属于 AI 领域；本站为便于学习，将 AI 应用工程与模型/数据开发分成两条路径。"}</p>
    <p class="progress-note" data-progress-warning role="status"></p>
  </div>
</section>
