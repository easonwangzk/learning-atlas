---
import { withBase } from "@/lib/paths";
import { certificationLabel, localizePath, type Locale } from "@/i18n";
import type { Lesson, LessonLink } from "@/lib/viewTypes";
import { labs, labText } from "@/data/labs";
import { certifications } from "@/data/certifications";
interface Props { locale: Locale; lesson: Lesson; lessonId: string; trackLabel: string; previous?: LessonLink; next?: LessonLink }
const { locale, lesson, lessonId, trackLabel, previous, next } = Astro.props;
const isEn = locale === "en";
const relatedLab = labs.find((lab) => lab.lesson === `/learn/${lessonId}/`);
const relatedCerts = certifications.filter((cert) => cert.domains.some((domain) => domain.mappedLessons.includes(lessonId)));
const copy = {
  boundary: isEn ? "Exam boundary note" : "考试边界提示",
  boundaryText: isEn ? "This is an introductory study note and does not claim full exam-objective coverage. AZ-104/AZ-305 objectives follow the official 2026-04-17 study guides; AZ-700 follows the 2026-07-27 study guide." : "本课是入门学习笔记，不宣称覆盖完整考试大纲。AZ-104/AZ-305 目标以 2026-04-17 官方学习指南为准；AZ-700 以 2026-07-27 官方学习指南为准。",
  outline: isEn ? "Lesson outline" : "本课导航",
  sources: isEn ? "Official sources" : "官方来源",
  back: isEn ? "Back to track" : "返回轨道",
  nojs: isEn ? "Enable JavaScript to save learning progress in this browser." : "开启 JavaScript 后可保存本浏览器的学习进度。",
  prev: isEn ? "Previous lesson" : "上一课",
  next: isEn ? "Next lesson" : "下一课"
};
const outline = isEn
  ? [["#concept-notes", "Concept notes"], ["#tradeoffs-and-safety-exercise", "Tradeoffs and safety exercise"], ["#completion-checklist", "Completion checklist"]]
  : [["#概念笔记", "概念笔记"], ["#取舍与安全实验", "取舍与安全实验"], ["#完成检查", "完成检查"]];
---
<section class="atlas-page atlas-lesson">
  <div class="atlas-container reading-layout">
    <article class="prose reading-prose" data-reveal>
      <p class="eyebrow">{trackLabel} · {certificationLabel(lesson.data.cert, locale)} · {lesson.data.reviewedAt}</p>
      <h1>{lesson.data.title}</h1>
      <p class="lead">{lesson.data.summary}</p>
      <div class="tag-row">{lesson.data.tags.map((tag: string) => <span class="chip">{tag}</span>)}</div>
      <details class="exam-note">
        <summary>{copy.boundary}</summary>
        <p>{copy.boundaryText}</p>
      </details>
      <slot />
      <nav class="lesson-prev-next" aria-label={isEn ? "Lesson navigation" : "课程导航"}>
        {previous && <a href={withBase(previous.href)}>← {copy.prev}: {previous.title}</a>}
        {next && <a href={withBase(next.href)}>{copy.next}: {next.title} →</a>}
      </nav>
    </article>
    <aside class="reading-rail lesson-tools" data-reveal>
      <button class="text-button complete-toggle" type="button" data-complete-id={lessonId} aria-pressed="false">{isEn ? "Mark this lesson complete" : "标记本课完成"}</button>
      <p class="progress-note" data-progress-warning role="status"></p>
      <noscript><p class="progress-note">{copy.nojs}</p></noscript>
      <h2>{copy.outline}</h2>
      <ol class="mini-outline">{outline.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ol>
      <h2>{copy.sources}</h2>
      <ul class="source-list">{lesson.data.sourceUrls.map((url: string) => <li><a href={url} rel="noreferrer">{url}</a></li>)}</ul>
      <h2>{isEn ? "Practice and context" : "实践与背景"}</h2>
      <ul class="source-list">
        {relatedLab && <li><a href={withBase(localizePath(`/labs/${relatedLab.slug}/`, locale))}>{labText(relatedLab, locale).title}</a></li>}
        {relatedCerts.map((cert) => <li><a href={withBase(localizePath(`/certifications/${cert.slug}/`, locale))}>{cert.title[locale]}</a></li>)}
        <li><a href={`${withBase(localizePath("/notes/", locale))}#glossary`}>{isEn ? "Glossary and common pitfalls" : "术语与常见误区"}</a></li>
      </ul>
      <a class="text-link" href={withBase(localizePath(`/learn/${lesson.data.track}/`, locale))}>← {copy.back}</a>
    </aside>
  </div>
</section>
