---
import { certifications, certText } from "@/data/certifications";
import { withBase } from "@/lib/paths";
import { localizePath, type Locale } from "@/i18n";
interface Props { locale: Locale }
const { locale } = Astro.props; const isEn = locale === "en";
const copy = { eyebrow: isEn ? "Learn · Certifications" : "系统学习 · 认证路线", title: isEn ? "Certification study routes" : "认证学习路线", lead: isEn ? "This compatibility page points to the certification lenses now integrated into Learn." : "认证学习视角已并入系统学习；此页面保留旧链接兼容。", sequence: isEn ? "Suggested learning sequence: AZ-104 → AZ-700 → AZ-305. This is not an official prerequisite chain." : "建议学习顺序：AZ-104 → AZ-700 → AZ-305，不是官方考试先修链。" };
---
<section class="atlas-page"><div class="atlas-container"><header class="atlas-intro" data-reveal><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p class="lead">{copy.lead}</p><p><a class="text-link" href={`${withBase(localizePath("/learn/", locale))}#certifications`}>{isEn ? "Open certification routes in Learn" : "前往系统学习中的认证路线"} →</a></p><p class="callout">{copy.sequence}</p></header><div class="certification-index">{certifications.map((cert) => { const text = certText(cert, locale); return <a href={withBase(localizePath(`/certifications/${cert.slug}/`, locale))}><p class="eyebrow">{cert.code} · {isEn ? "Objectives effective" : "大纲生效于"} {text.guideDate}</p><h2>{text.title}</h2><p>{text.intro}</p><ul>{text.domains.map((domain) => <li>{domain.weight} · {domain.name}</li>)}</ul></a>; })}</div></div></section>
