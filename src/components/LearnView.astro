---
import { tracks, trackText } from "@/data/tracks";
import { labs } from "@/data/labs";
import { certifications } from "@/data/certifications";
import { withBase } from "@/lib/paths";
import { lessonRoute, lessonProgressId } from "@/lib/lessons";
import { localizePath, certificationLabel, type Locale } from "@/i18n";
import type { Lesson } from "@/lib/viewTypes";
interface Props { locale: Locale; lessons: readonly Lesson[] }
const { locale, lessons } = Astro.props;
const isEn = locale === "en";
const copy = { eyebrow: isEn ? "Learn" : "系统学习", title: isEn ? "Course catalog" : "课程目录", lead: isEn ? "Eighteen introductory lessons grouped into cloud platform foundations and AI application/model development." : "十八篇入门课程，分为云平台基础与 AI 应用/模型开发两组。", foundations: isEn ? "Cloud platform foundations" : "云平台基础", intelligence: isEn ? "Intelligence applications and models" : "智能应用与模型", open: isEn ? "Open track" : "进入轨道", lessons: isEn ? "lessons" : "篇课程" };
const groups = [
  { title: copy.foundations, slugs: ["compute", "storage", "network", "database"] },
  { title: copy.intelligence, slugs: ["ai", "ml"] }
];
---
<section class="atlas-page atlas-knowledge"><div class="atlas-container">
<header class="atlas-intro" data-reveal><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p class="lead">{copy.lead}</p></header>
{groups.map((group) => <section class="content-band" data-reveal><h2>{group.title}</h2><ol class="chapter-list">{tracks.filter((track) => group.slugs.includes(track.slug)).map((track) => { const text = trackText(track, locale); const trackLessons = lessons.filter((lesson) => lesson.data.track === track.slug).sort((a, b) => a.data.order - b.data.order); const ids = trackLessons.map(lessonProgressId); const lab = labs.find((item) => item.track === track.slug); return <li class="chapter-row"><span class="chapter-number">{String(tracks.indexOf(track) + 1).padStart(2, "0")}</span><div class="chapter-main"><p class="eyebrow">{text.kicker}</p><h3><a href={withBase(localizePath(`/learn/${track.slug}/`, locale))}>{text.title}</a></h3><p>{text.summary}</p><p class="chapter-meta">{track.certs.map((cert) => certificationLabel(cert, locale)).join(" / ")} · {trackLessons.length} {copy.lessons} · <span data-progress-count={ids.join(",")}>0/{ids.length}</span></p><details class="chapter-lessons"><summary>{isEn ? "Lessons and context" : "课程与上下文"}</summary><ol>{trackLessons.map((lesson) => <li><a href={withBase(lessonRoute(lesson, locale))}>{lesson.data.title}</a><span>{lesson.data.summary}</span></li>)}{lab && <li><a href={withBase(localizePath(`/labs/${lab.slug}/`, locale))}>{isEn ? "Related lab" : "关联实验"}</a></li>}</ol></details></div><a class="text-link" href={withBase(localizePath(`/learn/${track.slug}/`, locale))}>{copy.open}</a></li>; })}</ol></section>)}
<section id="certifications" class="content-band" data-reveal><h2>{isEn ? "Certification routes" : "认证路线"}</h2><p>{isEn ? "Certification objectives are learning lenses inside Learn, not a separate top-level section." : "认证大纲作为系统学习中的学习视角，不再单独设为一级栏目。"}</p><div class="certification-index">{certifications.map((cert) => <a href={withBase(localizePath(`/certifications/${cert.slug}/`, locale))}><span class="eyebrow">{cert.code}</span><h3>{cert.title[locale]}</h3><p>{cert.intro[locale]}</p></a>)}</div></section>
<p class="progress-note" data-progress-warning role="status"></p>
</div></section>
