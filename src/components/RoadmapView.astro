---
import { tracks, trackText } from "@/data/tracks";
import { labs } from "@/data/labs";
import { withBase } from "@/lib/paths";
import { lessonProgressId, lessonRoute } from "@/lib/lessons";
import { localizePath, type Locale } from "@/i18n";
import type { Lesson } from "@/lib/viewTypes";
interface Props { locale: Locale; lessons: readonly Lesson[] }
const { locale, lessons } = Astro.props; const isEn = locale === "en"; const ids = lessons.map(lessonProgressId);
const nextLesson = [...lessons].sort((a, b) => tracks.findIndex((track) => track.slug === a.data.track) - tracks.findIndex((track) => track.slug === b.data.track) || a.data.order - b.data.order)[0];
---
<section class="atlas-page">
  <div class="atlas-container">
    <header class="atlas-intro" data-reveal>
      <p class="eyebrow">{isEn ? "Roadmap" : "学习路线图"}</p><h1>{isEn ? "Progress and next step" : "学习进度与下一步"}</h1>
      <p class="lead">{isEn ? "Choose one next lesson from your unfinished work. Progress is stored in this browser only and is shared with course pages." : "根据未完成的课程明确一个下一步。进度只保存在当前浏览器，与课程页共享。"}</p>
      <p><strong data-progress-count={ids.join(",")}>0/{ids.length}</strong> {isEn ? "lessons complete" : "篇课程已完成"}</p>
      <a class="text-button" data-roadmap-next data-review-href={withBase(localizePath("/certifications/", locale))} href={withBase(lessonRoute(nextLesson, locale))}>
        {isEn ? "Next: " : "下一步："}{nextLesson.data.title}
      </a>
      <p data-roadmap-message role="status"></p><p data-progress-warning role="status"></p>
      <noscript><p>{isEn ? "Enable JavaScript to load your saved progress; the course sequence remains available below." : "开启 JavaScript 后可读取已保存的进度；下方仍可浏览完整课程顺序。"}</p></noscript>
    </header>
    <div class="roadmap-grid">
      {tracks.map((track) => {
        const text = trackText(track, locale);
        const peers = lessons.filter((lesson) => lesson.data.track === track.slug).sort((a, b) => a.data.order - b.data.order);
        const trackIds = peers.map(lessonProgressId);
        const lab = labs.find((item) => item.track === track.slug);
        return <section class="roadmap-track" data-roadmap-track={track.slug}>
          <p class="eyebrow">{text.kicker}</p><h2>{text.title}</h2><p>{text.summary}</p>
          <svg class="progress-bars" viewBox="0 0 120 16" role="img" aria-label={text.title}>
            <rect x="0" y="4" width="120" height="8" rx="4" class="bar-bg" />
            <rect x="0" y="4" width="0" height="8" rx="4" class="bar-fill" data-progress-bar={trackIds.join(",")} />
          </svg>
          <p><strong data-progress-count={trackIds.join(",")}>0/{trackIds.length}</strong></p>
          <ol>{peers.map((lesson) => <li><a data-roadmap-lesson={lessonProgressId(lesson)} href={withBase(lessonRoute(lesson, locale))}>{lesson.data.title}</a></li>)}</ol>
          {lab && <a class="text-link" href={withBase(localizePath(`/labs/${lab.slug}/`, locale))}>{isEn ? "Practice lab" : "关联实验"}</a>}
        </section>;
      })}
    </div>
    <section class="content-band">
      <h2>{isEn ? "Suggested sequence, not certification prerequisites" : "建议学习顺序，不是认证先修要求"}</h2>
      <ol class="phase-list">
        <li><strong>{isEn ? "Cloud foundations" : "云平台基础"}</strong> — {isEn ? "Compute, storage, network, and database." : "计算、存储、网络与数据库。"}</li>
        <li><strong>{isEn ? "Applications and models" : "应用与模型"}</strong> — {isEn ? "RAG, multimodal input, data preparation, evaluation, and MLOps." : "RAG、多模态输入、数据准备、评估与 MLOps。"}</li>
        <li><strong>{isEn ? "Architecture review" : "架构评审"}</strong> — {isEn ? "Review official certification gaps, projects, and lab evidence." : "对照官方认证缺口、项目和实验证据。"}</li>
      </ol>
      <p>{isEn ? "Security, governance, monitoring, cost, and continuity apply throughout. Completing notes does not establish exam readiness." : "安全、治理、监控、成本和连续性贯穿所有阶段。完成笔记不等于考试就绪。"}</p>
    </section>
  </div>
</section>
