---
import type { Locale } from "@/i18n";

interface Props {
  slug: string;
  index: number;
  locale?: Locale;
  title?: string;
  tilt?: boolean;
  class?: string;
}

const { slug, index, locale = "zh", title = "", tilt = false, class: className = "" } = Astro.props;
const folio = String(index + 1).padStart(2, "0");
const labels: Record<string, { zh: string; en: string; code: string }> = {
  "customer-service-agent": { zh: "工单路由", en: "Ticket Routing", code: "HANDOFF" },
  "openai-repo": { zh: "媒体样例", en: "Media Samples", code: "PROMPT" },
  "amazon-multimodal-rag-assistant": { zh: "图文检索", en: "Image Retrieval", code: "VECTOR" },
  "recommendation-algorithm": { zh: "序列判断", en: "Sequence Choice", code: "RANK" },
  medllm: { zh: "医学评估", en: "Medical Review", code: "ALIGN" },
  "uchicago-rag-system": { zh: "文档归档", en: "Document Archive", code: "CHUNK" }
};
const label = labels[slug] ?? { zh: "学习案例", en: "Study Case", code: "CASE" };
---

<div
  class={`project-art project-artwork artwork-${slug} ${className}`}
  data-project-cover
  data-project-slug={slug}
  data-tilt={tilt ? "" : undefined}
  style={`view-transition-name: project-${slug};`}
  aria-hidden="true"
>
  <div class="artwork-paper artwork-paper-a"></div>
  <div class="artwork-paper artwork-paper-b"></div>
  <div class="artwork-paper artwork-paper-c"></div>
  <div class="artwork-meta">
    <span>{folio}</span>
    <span>{label[locale]}</span>
  </div>
  <svg viewBox="0 0 720 420" role="img" aria-label={title} preserveAspectRatio="xMidYMid slice">
    <defs>
      <pattern id={`weave-${slug}`} width="18" height="18" patternUnits="userSpaceOnUse">
        <path class="art-faint" d="M0 9h18M9 0v18" />
      </pattern>
      <clipPath id={`slice-${slug}`}>
        <path d="M74 82h572v256H74z" />
      </clipPath>
    </defs>
    <rect class="art-base" x="0" y="0" width="720" height="420" />
    <rect class="art-weave" x="0" y="0" width="720" height="420" fill={`url(#weave-${slug})`} />
    <g clip-path={`url(#slice-${slug})`}>
      {slug === "customer-service-agent" && (
        <>
          <path class="art-panel strong" d="M78 96h250l-52 226H26z" />
          <path class="art-panel muted" d="M284 68h326l58 270H342z" />
          <path class="art-line broad" d="M138 132c118 36 185 92 202 168s82 72 194 0" />
          <text class="art-title" x="392" y="230">HAND</text>
          <text class="art-code" x="112" y="292">BFF → AGENT</text>
        </>
      )}
      {slug === "openai-repo" && (
        <>
          <path class="art-panel muted" d="M52 78h220v282H52z" />
          <path class="art-panel strong" d="M260 34h190v342H260z" />
          <path class="art-panel pale" d="M440 112h224v176H440z" />
          <path class="art-line broad" d="M90 308c86-86 168-86 246 0s150 88 258-10" />
          <text class="art-title" x="108" y="214">MEDIA</text>
          <text class="art-code" x="478" y="224">TEXT / VISION / VOICE</text>
        </>
      )}
      {slug === "amazon-multimodal-rag-assistant" && (
        <>
          <path class="art-panel pale" d="M58 96h172v218H58z" />
          <path class="art-panel strong" d="M214 58h220v276H214z" />
          <path class="art-panel muted" d="M412 122h248v190H412z" />
          <path class="art-line dotted" d="M126 196h448" />
          <path class="art-line broad" d="M132 288c96-116 210-126 342-28" />
          <text class="art-title" x="252" y="198">RAG</text>
          <text class="art-code" x="448" y="266">CLIP + STORE</text>
        </>
      )}
      {slug === "recommendation-algorithm" && (
        <>
          <path class="art-panel muted" d="M62 92h596v236H62z" />
          <path class="art-bars" d="M118 270h56v58h-56zM216 202h56v126h-56zM314 232h56v96h-56zM412 146h56v182h-56zM510 184h56v144h-56z" />
          <path class="art-line broad" d="M100 154c102 14 158 66 226 112s138 62 258-36" />
          <text class="art-title" x="98" y="206">RANK</text>
          <text class="art-code" x="444" y="132">EVALUATE</text>
        </>
      )}
      {slug === "medllm" && (
        <>
          <path class="art-panel pale" d="M120 74h410c36 0 64 29 64 64v198H184c-36 0-64-29-64-64z" />
          <path class="art-panel strong" d="M184 44h340c25 0 46 20 46 46v214H232c-27 0-48-22-48-48z" />
          <path class="art-line broad" d="M258 148h190M258 198h248M258 248h144" />
          <text class="art-title" x="250" y="332">QA</text>
          <text class="art-code" x="424" y="154">ALIGNMENT</text>
        </>
      )}
      {slug === "uchicago-rag-system" && (
        <>
          <path class="art-panel muted" d="M88 132h178l34 38h318v166H88z" />
          <path class="art-panel pale" d="M154 82h382v222H154z" />
          <path class="art-panel strong" d="M216 52h258v284H216z" />
          <path class="art-line broad" d="M262 126h148M262 174h186M262 222h120M262 270h158" />
          <text class="art-title" x="436" y="268">DOC</text>
          <text class="art-code" x="112" y="364">PDF / HTML</text>
        </>
      )}
    </g>
    <text class="art-ghost" x="42" y="394">{label.code}</text>
  </svg>
</div>
