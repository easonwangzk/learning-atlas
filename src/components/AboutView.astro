---
import { withBase } from "@/lib/paths";
import { localizePath, type Locale } from "@/i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const isEn = locale === "en";
const sections = isEn ? [
  ["Author", "I'm Zikai Wang (Eason). My public GitHub profile describes a focus on Azure-native cloud architecture, applied AI, and enterprise generative-AI delivery. This atlas connects the concepts I study with public project cases and reproducible local exercises."],
  ["Scope", "Learning Atlas is a static GitHub Pages site for architecture learning. It is not an official Microsoft course, not a certification claim, and not a production benchmark report."],
  ["Privacy and progress", "Lesson completion status stays only in this browser under learning-atlas-progress-v1. There is no account, backend, external model call, or cross-device sync."],
  ["Source policy", "Lessons are original study notes with official links. Project pages use public GitHub README facts and explicitly mark unknowns, prototypes, or teaching questions."],
  ["Hugging Face", "A personal Hugging Face profile or project URL has not been verified. The link provided here goes to Hugging Face Learn as a general resource, not a personal account."],
  ["Update guide", "Add new navigation through the central typed navigation model, then update sitemap, search, verification counts, and bilingual pages together."]
] : [
  ["作者", "我是 Zikai Wang（Eason），关注 Azure 原生云架构、应用 AI 与企业生成式 AI 落地。这个学习站把正在梳理的概念、公开项目案例与可复现的本地实验连接起来；个人背景可在公开 GitHub 主页查看。"],
  ["范围", "Learning Atlas 是托管在 GitHub Pages 的静态学习站，用于架构学习；它不是 Microsoft 官方课程，不代表已获认证，也不是生产基准报告。"],
  ["隐私与进度", "课程完成状态只保存在当前浏览器 learning-atlas-progress-v1。没有账户、后端、外部模型调用或跨设备同步。"],
  ["来源政策", "课程是原创学习笔记并附官方链接。项目页只使用公开 GitHub README 事实，并明确标注未知、原型或教学问题。"],
  ["Hugging Face", "个人 Hugging Face 主页或项目 URL 尚未验证。这里提供 Hugging Face Learn 通用学习链接，不伪造个人账号。"],
  ["更新指南", "新增导航必须先进入中央类型化导航模型，再同步站点地图、搜索、验证计数和双语页面。"]
];
---
<section class="atlas-page atlas-about">
  <div class="atlas-container reading-layout">
    <article class="prose reading-prose profile-text" data-reveal>
      <p class="eyebrow">{isEn ? "About" : "关于作者"}</p>
      <h1>{isEn ? "Zikai Wang (Eason)" : "Zikai Wang（Eason）"}</h1>
      <p class="lead">{isEn ? "Cloud architecture, applied AI, and learning through building." : "云架构、应用 AI，以及边学习边实践。"}</p>
      {sections.map(([title, body], index) => <section class="profile-section" id={["author", "scope", "privacy", "sources", "hugging-face", "updates"][index]}>
        <span class="chapter-number">{String(index + 1).padStart(2, "0")}</span><h2>{title}</h2><p>{body}</p>
      </section>)}
      <section class="profile-section" id="design-references">
        <span class="chapter-number">07</span><h2>{isEn ? "Design references" : "设计参考"}</h2>
        <p>{isEn ? "The dark project stage and perspective background take inspiration from " : "深色作品舞台与透视背景参考了 "}<a href="https://www.awwwards.com/sites/jesper-landberg-4" rel="noreferrer">Jesper Landberg</a>{isEn ? "; cursor motion takes inspiration from " : "；光标运动参考了 "}<a href="https://magicui.design/docs/components/smooth-cursor" rel="noreferrer">Magic UI</a>{isEn ? ". Artwork and interactions are independently implemented." : "。图形与交互为独立实现。"}</p>
      </section>
    </article>
    <aside class="reading-rail" data-reveal>
      <h2>{isEn ? "Public profiles" : "公开主页"}</h2>
      <ul><li><a href="https://github.com/easonwangzk" rel="noreferrer">GitHub: easonwangzk</a></li><li><a href="https://github.com/easonwangzk/easonwangzk" rel="noreferrer">{isEn ? "Author profile" : "个人简介"}</a></li></ul>
      <p>{isEn ? "Personal Hugging Face profile: not confirmed." : "个人 Hugging Face 主页：待确认。"}</p>
      <a href="https://huggingface.co/learn" rel="noreferrer">{isEn ? "Hugging Face Learn (general resource)" : "Hugging Face Learn（通用学习资料）"}</a>
      <h2>{isEn ? "Site boundaries" : "本站边界"}</h2>
      <p>{isEn ? "Static GitHub Pages hosting; no backend or runtime model calls. MIT covers original site code only; third-party sources retain their own licenses." : "使用 GitHub Pages 静态托管，无后端或运行时模型调用。MIT 仅覆盖原创站点代码，第三方来源保留原有许可证。"}</p>
      <a class="text-link" href={withBase(localizePath("/knowledge-map/", locale))}>{isEn ? "Open Knowledge Map" : "打开知识地图"}</a>
    </aside>
  </div>
</section>
