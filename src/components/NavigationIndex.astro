---
import type { Locale } from "@/i18n";
import { primaryNavigation, secondaryNavigation, localizeNavPath } from "@/data/navigation";
import { withBase } from "@/lib/paths";
interface Props { locale: Locale; current?: string }
const { locale, current } = Astro.props;
---
<div class="navigation-index">
  {primaryNavigation.map((entry, index) => (
    <section class="navigation-section">
      <a href={withBase(localizeNavPath(entry.path, locale))} data-nav-key={entry.key} aria-current={current === entry.key ? "page" : undefined}>
        <span class="navigation-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <span><strong data-nav-label>{entry.label[locale]}</strong><span data-nav-purpose>{entry.purpose[locale]}</span></span>
        <span aria-hidden="true">↗</span>
      </a>
      {entry.children.length > 0 && (
        <details class="navigation-children">
          <summary>{locale === "en" ? "Browse topics" : "展开子栏目"}</summary>
          {entry.children.map((child) => <a data-nav-child={child.key} href={withBase(localizeNavPath(child.path, locale))}>{child.label[locale]}</a>)}
        </details>
      )}
    </section>
  ))}
</div>
<nav class="navigation-utilities" aria-label={locale === "en" ? "Supporting tools" : "辅助工具"}>
  {secondaryNavigation.map((entry) => <a href={withBase(localizeNavPath(entry.path, locale))} data-nav-key={entry.key}>{entry.label[locale]}</a>)}
</nav>
