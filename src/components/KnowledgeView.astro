---
import { tracks, trackText } from "@/data/tracks";
import { withBase } from "@/lib/paths";
import { lessonRoute, lessonProgressId } from "@/lib/lessons";
import { certificationLabel, localizePath, type Locale } from "@/i18n";
import type { Lesson } from "@/lib/viewTypes";
interface Props { locale: Locale; lessons: readonly Lesson[] }
const { locale, lessons } = Astro.props;
const isEn = locale === "en";
const copy = {
  eyebrow: isEn ? "Knowledge index" : "知识索引",
  title: isEn ? "Knowledge" : "知识地图",
  lead: isEn ? "Six tracks, eighteen original lessons, official sources, and browser-only progress." : "六条轨道、十八篇原创课程、官方来源与仅保存在浏览器的学习进度。",
  lessons: isEn ? "lessons" : "篇课程",
  open: isEn ? "Open track" : "进入轨道",
  progress: isEn ? "completed" : "已完成"
};
---
<section class="atlas-page atlas-knowledge">
  <div class="atlas-container">
    <header class="atlas-intro" data-reveal>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
    </header>
    <ol class="chapter-list">
      {tracks.map((track, index) => {
        const text = trackText(track, locale);
        const trackLessons = lessons.filter((lesson) => lesson.data.track === track.slug).sort((a, b) => a.data.order - b.data.order);
        const ids = trackLessons.map(lessonProgressId);
        return (
          <li class="chapter-row" data-reveal>
            <span class="chapter-number">{String(index + 1).padStart(2, "0")}</span>
            <div class="chapter-main">
              <p class="eyebrow">{text.kicker}</p>
              <h2><a href={withBase(localizePath(`/learn/${track.slug}/`, locale))}>{text.title}</a></h2>
              <p>{text.summary}</p>
              <p class="chapter-meta">{track.certs.map((cert) => certificationLabel(cert, locale)).join(" / ")} · {trackLessons.length} {copy.lessons} · <span data-progress-count={ids.join(",")}>0/{ids.length}</span> {copy.progress}</p>
              <details class="chapter-lessons">
                <summary>{isEn ? "Lesson sequence" : "课程顺序"}</summary>
                <ol>
                  {trackLessons.map((lesson) => <li><a href={withBase(lessonRoute(lesson, locale))}>{lesson.data.title}</a><span>{lesson.data.summary}</span></li>)}
                </ol>
              </details>
            </div>
            <a class="text-link" href={withBase(localizePath(`/learn/${track.slug}/`, locale))}>{copy.open}</a>
          </li>
        );
      })}
    </ol>
    <p class="progress-note" data-progress-warning role="status"></p>
  </div>
</section>
