---
import type { Lab } from "@/data/labs";
import { labText } from "@/data/labs";
import { getLabResult, retrievalCorpus, retrievalQueries, type ChartModel, type LabInput, type ResultSection } from "@/lib/labCalculators";
import { withBase } from "@/lib/paths";
import { localizePath, type Locale } from "@/i18n";

interface Props { locale: Locale; lab: Lab }

const { locale, lab } = Astro.props;
const isEn = locale === "en";
const text = labText(lab, locale);
const inputDefaults = Object.fromEntries(lab.inputs.map((input) => [input.name, input.value])) as LabInput;
const initialResult = getLabResult(lab.kind, inputDefaults, locale);
const chartId = `lab-chart-${lab.slug}-${locale}`;
const chartTitleId = `${chartId}-title`;
const maxChartValue = (chart: ChartModel) => Math.max(1, ...chart.series.flatMap((series) => series.values));
const chartHeight = (chart: ChartModel) => Math.max(180, 64 + chart.labels.length * Math.max(26, chart.series.length * 16));
const barWidth = (value: number, max: number) => Math.max(0, Math.round((value / max) * 360));
const combinedSections: readonly ResultSection[] = [
  { title: isEn ? "Key results" : "关键结果", rows: initialResult.summaryRows },
  ...initialResult.detailSections
];
---
<section class="atlas-page">
  <div class="atlas-container reading-layout">
    <article class="prose reading-prose" data-reveal>
      <p class="eyebrow">{text.trackLabel} · {text.cert}</p>
      <h1>{text.title}</h1>
      <p class="lead">{text.summary}</p>

      <section class="lab-panel" data-lab={lab.kind} data-lab-locale={locale}>
        <h2>{isEn ? "Run the local exercise" : "运行本地实验"}</h2>
        <form class="lab-form" data-lab-form novalidate>
          {text.inputs.map((input) => (
            <label>
              <span>{input.label} ({input.unit})</span>
              <input
                class="input"
                name={input.name}
                type="number"
                value={input.value}
                min={input.min}
                max={input.max}
                step={input.step}
                required
                aria-label={`${input.label} (${input.unit})`}
                data-label={input.label}
                data-unit={input.unit}
              />
              <small>{isEn ? "Allowed" : "范围"}: {input.min}–{input.max}; {isEn ? "step" : "步长"} {input.step}</small>
            </label>
          ))}
          <button class="button primary" type="submit">{isEn ? "Run" : "运行"}</button>
          <button class="button" type="reset">{isEn ? "Reset" : "重置"}</button>
        </form>

        <div class="lab-results" data-lab-results aria-live="polite">
          {combinedSections.map((section) => (
            <section class="lab-result-section">
              <h3>{section.title}</h3>
              <table class="lab-data-table" data-lab-table>
                <thead>
                  <tr><th scope="col">{isEn ? "Metric" : "指标"}</th><th scope="col">{isEn ? "Value" : "值"}</th><th scope="col">{isEn ? "Unit" : "单位"}</th></tr>
                </thead>
                <tbody>
                  {section.rows.map((row) => <tr><th scope="row">{row.label}</th><td>{row.value}</td><td>{row.unit ?? ""}</td></tr>)}
                </tbody>
              </table>
            </section>
          ))}
          <ul>
            {initialResult.notes.map((note) => <li>{note}</li>)}
          </ul>
        </div>

        <svg
          id={chartId}
          class="lab-chart"
          data-lab-chart
          viewBox={`0 0 640 ${chartHeight(initialResult.chart)}`}
          role="img"
          aria-labelledby={chartTitleId}
        >
          <title id={chartTitleId}>{initialResult.chart.title}</title>
          <g class="chart-legend" aria-hidden="true">
            {initialResult.chart.series.map((series, seriesIndex) => (
              <g transform={`translate(${140 + seriesIndex * 180} 18)`}>
                <rect width="14" height="10" rx="2" class={seriesIndex === 0 ? "bar-fill" : "bar-compare"} />
                <text x="20" y="10">{series.name}</text>
              </g>
            ))}
          </g>
          {initialResult.chart.labels.map((label, labelIndex) => {
            const y = 48 + labelIndex * Math.max(26, initialResult.chart.series.length * 16);
            const max = maxChartValue(initialResult.chart);
            return (
              <g>
                <text x="8" y={y + 14}>{label}</text>
                {initialResult.chart.series.map((series, seriesIndex) => {
                  const width = barWidth(series.values[labelIndex] ?? 0, max);
                  const barY = y + seriesIndex * 14;
                  return (
                    <g>
                      <rect x="190" y={barY} width={width} height="10" rx="3" class={seriesIndex === 0 ? "bar-fill" : "bar-compare"} />
                      <text x={200 + width} y={barY + 10}>{series.values[labelIndex]} {initialResult.chart.unit}</text>
                    </g>
                  );
                })}
              </g>
            );
          })}
        </svg>

        <noscript>
          <p>{isEn ? "JavaScript is disabled. The table and chart above show the reproducible default-input result." : "JavaScript 已禁用。上方表格和图表显示可复现的默认输入结果。"}</p>
        </noscript>
      </section>

      <section>
        <h2>{isEn ? "Experiment steps" : "实验步骤"}</h2>
        <ol>{text.steps.map((step) => <li>{step}</li>)}</ol>
      </section>
      {lab.kind === "ai" && <section class="retrieval-evidence">
        <h2>{isEn ? "Reproducible input corpus and relevance labels" : "可复现的输入语料与相关性标签"}</h2>
        <p>{isEn ? "These five original English sentences and query relevance IDs are the complete teaching input. Scores count exact query-token matches; tied documents are ordered by ID." : "下列五条原创英文句子与查询相关性 ID 是本实验的完整输入。分数按查询词的精确匹配数量计算，同分文档按 ID 排序。"}</p>
        <dl class="term-list">{retrievalCorpus.map((document) => <div><dt>{document.id}</dt><dd lang="en">{document.text}</dd></div>)}</dl>
        <ul>{retrievalQueries.map((query) => <li><span lang="en">{query.q}</span> — {isEn ? "relevant IDs" : "相关 ID"}: {query.relevant.join(", ")}</li>)}</ul>
      </section>}

      <section>
        <h2>{isEn ? "Sources, formula, and limitations" : "来源、公式与限制"}</h2>
        <p>{text.source}</p>
        <p>{text.provenance}</p>
        <p>{text.limitation}</p>
        <ul>
          {text.sourceUrls.map((source) => <li><a class="text-link" href={source.href}>{source.label}</a></li>)}
        </ul>
      </section>
    </article>
    <aside class="reading-rail" data-reveal>
      <h2>{isEn ? "Context links" : "上下文链接"}</h2>
      <a class="text-link" href={withBase(localizePath(text.lesson, locale))}>{isEn ? "Related lesson" : "关联课程"}</a>
      <a class="text-link" href={withBase(localizePath("/labs/", locale))}>← {isEn ? "All labs" : "全部实验"}</a>
      <p>{isEn ? "Inputs stay in the page. They are not stored, sent, or used to call cloud services." : "输入只留在页面中，不保存、不发送，也不会调用云服务。"}</p>
    </aside>
  </div>
</section>
