---
import ProjectArtwork from "@/components/ProjectArtwork.astro";
import { withBase } from "@/lib/paths";
import { localizePath, type Locale } from "@/i18n";
import type { Project } from "@/lib/viewTypes";
interface Props { locale: Locale; projects: readonly Project[] }
const { locale, projects } = Astro.props;
const isEn = locale === "en";
const topics = ["all", ...Array.from(new Set(projects.flatMap((project) => [...project.topics])))];
const copy = { eyebrow: isEn ? "Public cases" : "公开案例", title: isEn ? "Projects" : "项目案例", lead: isEn ? "A quiet index of public GitHub repositories, README-based boundaries, architecture reading paths, and learning takeaways." : "公开 GitHub 仓库的克制索引：保留 README 边界、架构阅读顺序和学习要点。", search: isEn ? "Search projects" : "搜索项目", featured: isEn ? "Featured" : "精选", index: isEn ? "Index" : "索引", all: isEn ? "All" : "全部", clear: isEn ? "Clear filters" : "清空筛选", open: isEn ? "Open case" : "打开案例", empty: isEn ? "No matching projects. Reset filters or try another keyword." : "没有匹配项目。请重置筛选或换一个关键词。" };
---
<section class="atlas-page atlas-projects">
  <div class="atlas-container" data-filter-scope>
    <header class="atlas-intro" data-reveal>
      <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p class="lead">{copy.lead}</p>
    </header>
    <div class="archive-toolbar">
      <div class="view-toggle" role="group" aria-label={isEn ? "Project view" : "项目视图"}><button class="filter-button" type="button" data-view="gallery" aria-pressed="true">{copy.featured}</button><button class="filter-button" type="button" data-view="index" aria-pressed="false">{copy.index}</button></div>
      <label class="search-line"><span>{copy.search}</span><input data-local-search type="search" /></label>
    </div>
    <div class="filter-row">{topics.map((topic) => <button class="filter-button" type="button" data-filter={topic} aria-pressed={topic === "all" ? "true" : "false"}>{topic === "all" ? copy.all : topic}</button>)}<button class="text-button" type="button" data-filter-reset>{copy.clear}</button></div>
    <p class="muted" data-filter-count role="status">{projects.length} / {projects.length} {isEn ? "items" : "项"}</p>
    <ol class="project-archive">
      {projects.map((project, index) => (
        <li class="project-row" data-filter-item={project.topics.join(" ")} data-reveal>
          <a class="project-poster" href={withBase(localizePath(`/projects/${project.slug}/`, locale))} data-tilt><ProjectArtwork slug={project.slug} index={index} locale={locale} title={project.title} /></a>
          <span class="chapter-number">{String(index + 1).padStart(2, "0")}</span>
          <div><p class="eyebrow">{project.topics.join(" / ")}</p><h2><a href={withBase(localizePath(`/projects/${project.slug}/`, locale))}>{project.title}</a></h2><p>{project.summary}</p><details><summary>{isEn ? "Boundary" : "边界"}</summary><p>{project.status}</p></details></div>
          <a class="text-link" href={withBase(localizePath(`/projects/${project.slug}/`, locale))}>{copy.open}</a>
        </li>
      ))}
    </ol>
    <p class="callout hidden" data-empty role="status">{copy.empty}</p>
  </div>
</section>
