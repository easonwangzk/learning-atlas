---
import { glossary, pitfalls, decisionNotes } from "@/data/notes";
import type { Locale } from "@/i18n";
interface Props { locale: Locale }
const { locale } = Astro.props; const isEn = locale === "en";
---
<section class="atlas-page"><div class="atlas-container reading-layout"><article class="prose reading-prose" data-reveal><p class="eyebrow">{isEn ? "Notes" : "知识笔记"}</p><h1>{isEn ? "Short notes, glossary, and pitfalls" : "短笔记、术语与常见误区"}</h1><p class="lead">{isEn ? "Original educational reminders for Azure cloud and AI reviews, not a record of real production incidents." : "用于 Azure 云与 AI 架构评审的原创教学摘要，不冒充真实生产故障记录。"}</p><p class="muted">{isEn ? "Organized on" : "整理于"} 2026-10-10</p><section id="glossary"><h2>{isEn ? "Glossary" : "术语表"}</h2><dl class="term-list">{glossary.map((item) => <div id={item.id}><dt>{item.term} — {item.full}</dt><dd>{isEn ? item.en : item.zh}</dd></div>)}</dl></section><section id="pitfalls"><h2>{isEn ? "Common pitfalls" : "常见误区"}</h2>{pitfalls.map((item) => <section id={item.id} class="profile-section"><h3>{item.title[locale]}</h3><p>{item.body[locale]}</p></section>)}</section><section id="decisions"><h2>{isEn ? "Architecture decision notes" : "架构决策短笔记"}</h2>{decisionNotes.map((item) => <section id={item.id} class="profile-section"><h3>{item.title[locale]}</h3><p>{item.body[locale]}</p></section>)}</section><section><h2>{isEn ? "Further reading" : "延伸阅读"}</h2><ul><li><a href={`https://learn.microsoft.com/${isEn ? "en-us" : "zh-cn"}/azure/well-architected/`}>Azure Well-Architected Framework</a></li><li><a href={`https://learn.microsoft.com/${isEn ? "en-us" : "zh-cn"}/azure/private-link/`}>Azure Private Link</a></li><li><a href={`https://learn.microsoft.com/${isEn ? "en-us" : "zh-cn"}/azure/backup/`}>Azure Backup</a></li></ul></section></article><aside class="reading-rail" data-reveal><h2>{isEn ? "On this page" : "本页目录"}</h2><ul><li><a href="#glossary">{isEn ? "Glossary" : "术语表"}</a></li><li><a href="#pitfalls">{isEn ? "Common pitfalls" : "常见误区"}</a></li><li><a href="#decisions">{isEn ? "Decision notes" : "决策笔记"}</a></li></ul><details><summary>{isEn ? "All terms" : "全部术语"}</summary><ul>{glossary.map((item) => <li><a href={`#${item.id}`}>{item.term}</a></li>)}</ul></details></aside></div></section>
