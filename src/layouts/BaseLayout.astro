---
import "@/styles/global.css";
import Atmosphere from "@/components/Atmosphere.astro";
import SiteChrome from "@/components/SiteChrome.astro";
import { withBase, canonical } from "@/lib/paths";
import { alternatePath, stripLocale, ui, type Locale } from "@/i18n";
import { allNavigation } from "@/data/navigation";

interface Props {
  title: string;
  description: string;
  current?: string;
  locale?: Locale;
  switchPath?: string;
  canonicalPath?: string;
  scene?: boolean;
  pageKind?: string;
  crumbs?: { label: string; href?: string }[];
  contextLabel?: string;
}

const { title, description, current = "", locale = "zh", switchPath, canonicalPath, scene = false, pageKind = current?.toLowerCase() || "content", crumbs = [], contextLabel } = Astro.props;
const t = ui[locale];
const notFound = title === "404";
const routePath = notFound ? "/404.html" : (canonicalPath ?? stripLocale(Astro.url.pathname.replace(withBase("/").replace(/\/$/, ""), "") || "/"));
const englishPath = notFound ? "/en/404/" : routePath === "/" ? "/en/" : `/en${routePath}`;
const otherPath = switchPath ?? (notFound ? (locale === "en" ? routePath : englishPath) : alternatePath(routePath, locale));
const translatedTitle = allNavigation.find((entry) => entry.label.en === title)?.label[locale] ?? title;
const pageTitle = title === "Learning Atlas" ? title : `${translatedTitle} · Learning Atlas`;
---

<!doctype html>
<html lang={t.lang} dir={t.dir} data-not-found={notFound ? "true" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const param = new URLSearchParams(window.location.search).get("scoutTheme");
        const theme =
          param || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <script is:inline>
      document.documentElement.dataset.js = "true";
      (() => {
        if (new URLSearchParams(window.location.search).has("scoutTheme")) return;
        try {
          const saved = localStorage.getItem("learning-atlas-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (error) {
          console.warn("Learning Atlas theme preference is unavailable.", error);
        }
      })();
    </script>
    <style is:inline>
      :root {
        color-scheme: light;
        --cp-bg: #f7f4ef;
        --cp-bg-elevated: #fcfbf8;
        --cp-surface: #ffffff;
        --cp-surface-soft: #f5f5f5;
        --cp-border: #dedede;
        --cp-border-strong: #919191;
        --cp-text: #242424;
        --cp-text-muted: #5c5c5c;
        --cp-text-soft: #6f6f6f;
        --cp-accent: #b11f4b;
        --cp-accent-hover: #9a1a41;
        --cp-accent-soft: rgba(177, 31, 75, 0.08);
        --cp-accent-fg: #ffffff;
        --cp-success: #16a34a;
        --cp-danger: #dc2626;
        --cp-warning: #f59e0b;
        --cp-link: #0078d4;
        --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
        --cp-overlay: rgba(255, 255, 255, 0.8);
        --cp-panel: rgba(255, 255, 255, 0.86);
        --cp-panel-strong: rgba(255, 255, 255, 0.96);
        --cp-sheen: rgba(255, 255, 255, 0.55);
        --cp-highlight: rgba(177, 31, 75, 0.12);
      }
      html[data-theme="dark"] {
        color-scheme: dark;
        --cp-bg: #3d3b3a;
        --cp-bg-elevated: #343231;
        --cp-surface: #292929;
        --cp-surface-soft: #2e2e2e;
        --cp-border: #474747;
        --cp-border-strong: #5f5f5f;
        --cp-text: #dedede;
        --cp-text-muted: #919191;
        --cp-text-soft: #b0b0b0;
        --cp-accent: #fd8ea1;
        --cp-accent-hover: #fb7b91;
        --cp-accent-soft: rgba(253, 142, 161, 0.14);
        --cp-accent-fg: #1a1a1a;
        --cp-success: #4ade80;
        --cp-danger: #f87171;
        --cp-warning: #fbbf24;
        --cp-link: #4da6ff;
        --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
        --cp-overlay: rgba(41, 41, 41, 0.88);
        --cp-panel: rgba(41, 41, 41, 0.72);
        --cp-panel-strong: rgba(41, 41, 41, 0.96);
        --cp-sheen: rgba(255, 255, 255, 0.04);
        --cp-highlight: rgba(253, 142, 161, 0.12);
      }
    </style>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical(locale === "en" ? englishPath : routePath)} />
    <link rel="alternate" hreflang="zh-CN" href={canonical(routePath)} />
    <link rel="alternate" hreflang="en" href={canonical(englishPath)} />
    <link rel="alternate" hreflang="x-default" href={canonical(routePath)} />
    {title === "404" && <meta name="robots" content="noindex" />}
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body class:list={["scene-body", scene && "home-stage-body"]}>
    <Atmosphere locale={locale} pageKind={pageKind} active={!scene} />
    <div class:list={["site-shell", scene && "scene-shell"]} data-shell="atlas" data-page-kind={pageKind}>
      <a class="skip-link" href="#content">{t.skip}</a>
      {!scene && <SiteChrome locale={locale} current={current} otherPath={otherPath} pageKind={pageKind} crumbs={crumbs} contextLabel={contextLabel} />}
      <main id="content">
        <slot />
      </main>
    </div>
    <script>
      import "@/scripts/site.ts";
    </script>
  </body>
</html>
