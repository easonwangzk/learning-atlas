---
import "@/styles/global.css";
import { withBase, canonical } from "@/lib/paths";
import { alternatePath, stripLocale, ui, type Locale } from "@/i18n";

interface Props {
  title: string;
  description: string;
  current?: string;
  locale?: Locale;
  switchPath?: string;
  canonicalPath?: string;
  scene?: boolean;
}

const { title, description, current = "", locale = "zh", switchPath, canonicalPath, scene = false } = Astro.props;
const t = ui[locale];
const notFound = title === "404";
const routePath = notFound ? "/404.html" : (canonicalPath ?? stripLocale(Astro.url.pathname.replace(withBase("/").replace(/\/$/, ""), "") || "/"));
const englishPath = notFound ? "/en/404/" : routePath === "/" ? "/en/" : `/en${routePath}`;
const otherPath = switchPath ?? (notFound ? (locale === "en" ? routePath : englishPath) : alternatePath(routePath, locale));
const nav = [
  ["Home", locale === "en" ? "/en/" : "/"],
  ["Knowledge", locale === "en" ? "/en/learn/" : "/learn/"],
  ["Projects", locale === "en" ? "/en/projects/" : "/projects/"],
  ["Resources", locale === "en" ? "/en/resources/" : "/resources/"],
  ["About", locale === "en" ? "/en/about/" : "/about/"]
] as const;
const pageTitle = title === "Learning Atlas" ? title : `${title} · Learning Atlas`;
---

<!doctype html>
<html lang={t.lang} dir={t.dir} data-not-found={notFound ? "true" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const param = new URLSearchParams(window.location.search).get("scoutTheme");
        const theme =
          param || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <script is:inline>
      document.documentElement.dataset.js = "true";
      (() => {
        if (new URLSearchParams(window.location.search).has("scoutTheme")) return;
        try {
          const saved = localStorage.getItem("learning-atlas-theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
          }
        } catch (error) {
          console.warn("Learning Atlas theme preference is unavailable.", error);
        }
      })();
    </script>
    <style is:inline>
      :root {
        color-scheme: light;
        --cp-bg: #f7f4ef;
        --cp-bg-elevated: #fcfbf8;
        --cp-surface: #ffffff;
        --cp-surface-soft: #f5f5f5;
        --cp-border: #dedede;
        --cp-border-strong: #919191;
        --cp-text: #242424;
        --cp-text-muted: #5c5c5c;
        --cp-text-soft: #6f6f6f;
        --cp-accent: #b11f4b;
        --cp-accent-hover: #9a1a41;
        --cp-accent-soft: rgba(177, 31, 75, 0.08);
        --cp-accent-fg: #ffffff;
        --cp-success: #16a34a;
        --cp-danger: #dc2626;
        --cp-warning: #f59e0b;
        --cp-link: #0078d4;
        --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.12);
        --cp-overlay: rgba(255, 255, 255, 0.8);
        --cp-panel: rgba(255, 255, 255, 0.86);
        --cp-panel-strong: rgba(255, 255, 255, 0.96);
        --cp-sheen: rgba(255, 255, 255, 0.55);
        --cp-highlight: rgba(177, 31, 75, 0.12);
      }
      html[data-theme="dark"] {
        color-scheme: dark;
        --cp-bg: #3d3b3a;
        --cp-bg-elevated: #343231;
        --cp-surface: #292929;
        --cp-surface-soft: #2e2e2e;
        --cp-border: #474747;
        --cp-border-strong: #5f5f5f;
        --cp-text: #dedede;
        --cp-text-muted: #919191;
        --cp-text-soft: #b0b0b0;
        --cp-accent: #fd8ea1;
        --cp-accent-hover: #fb7b91;
        --cp-accent-soft: rgba(253, 142, 161, 0.14);
        --cp-accent-fg: #1a1a1a;
        --cp-success: #4ade80;
        --cp-danger: #f87171;
        --cp-warning: #fbbf24;
        --cp-link: #4da6ff;
        --cp-shadow: 0 18px 48px rgba(0, 0, 0, 0.32);
        --cp-overlay: rgba(41, 41, 41, 0.88);
        --cp-panel: rgba(41, 41, 41, 0.72);
        --cp-panel-strong: rgba(41, 41, 41, 0.96);
        --cp-sheen: rgba(255, 255, 255, 0.04);
        --cp-highlight: rgba(253, 142, 161, 0.12);
      }
    </style>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical(locale === "en" ? englishPath : routePath)} />
    <link rel="alternate" hreflang="zh-CN" href={canonical(routePath)} />
    <link rel="alternate" hreflang="en" href={canonical(englishPath)} />
    <link rel="alternate" hreflang="x-default" href={canonical(routePath)} />
    {title === "404" && <meta name="robots" content="noindex" />}
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body class={scene ? "scene-body" : undefined}>
    <div class:list={["site-shell", scene && "scene-shell"]}>
      <a class="skip-link" href="#content">{t.skip}</a>
      {!scene && <header class="site-header">
        <nav class="nav" aria-label={t.navLabel}>
          <a class="brand" href={withBase(locale === "en" ? "/en/" : "/")}>
            <span class="brand-mark" aria-hidden="true">∴</span>
            <span>Learning Atlas</span>
          </a>
          <div class="nav-links" id="nav-links">
            {nav.map(([label, href]) => (
              <a href={withBase(href)} data-nav-key={label} aria-current={current === label ? "page" : undefined}>{t.nav[label]}</a>
            ))}
            <a href={withBase(locale === "en" ? "/en/search/" : "/search/")} data-nav-key="Search" aria-current={current === "Search" ? "page" : undefined}>{t.nav.Search}</a>
          </div>
          <div class="nav-actions">
            <a class="icon-button lang-switch" href={withBase(otherPath)} data-lang-switch>{t.switchLabel}</a>
            <button class="icon-button" type="button" data-motion-toggle aria-pressed="false" data-label-pause={t.motionPause} data-label-play={t.motionPlay} data-label-reduced={t.motionReduced}>{t.motionPause}</button>
            <button class="icon-button" type="button" data-theme-toggle aria-label={t.theme}>◐</button>
            <button class="icon-button menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="nav-links">{t.menu}</button>
          </div>
        </nav>
      </header>}
      <main id="content">
        <slot />
      </main>
      {!scene && <footer class="site-footer">
        <div class="container footer-grid">
          <div>
            <strong>Learning Atlas</strong>
            <p class="muted">{t.footerOne}</p>
            <p class="muted">{t.footerTwo}</p>
          </div>
          <a class="button" href={withBase(locale === "en" ? "/en/about/" : "/about/")}>{t.aboutSource}</a>
        </div>
      </footer>}
    </div>
    <script>
      import "@/scripts/site.ts";
    </script>
  </body>
</html>
